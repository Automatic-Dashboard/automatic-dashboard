{
  "name": "automatic-dashboard-frontend",
  "private": true,
  "version": "2026.12.3",
  "description": "Automatic Dashboard, le tableau de bord pour Home Assistant : moteur de tri, stratégie et cartes.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --minify false",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verifier": "npm run typecheck && npm run test && npm run build",
    "demo": "vite build --config vite.demo.config.ts"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
